{
  "name": "immersive-vocab-reader",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quality:sample": "node scripts/build-local-quality-sample.mjs",
    "quality:audit-corpus": "node scripts/audit-local-corpus-duplicates.mjs",
    "quality:repartition": "node scripts/repartition-local-quality-manifest.mjs",
    "quality:expand": "node scripts/expand-local-quality-manifest.mjs",
    "quality:propose-candidates": "node scripts/propose-local-candidate-promotions.mjs",
    "quality:baseline": "node scripts/run-git-baseline-quality.mjs",
    "quality:novels": "node scripts/run-local-quality-gate.mjs",
    "quality:audit-candidates": "node scripts/audit-production-candidates.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "dexie": "^4.2.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "vitest": "^4.1.10"
  }
}
